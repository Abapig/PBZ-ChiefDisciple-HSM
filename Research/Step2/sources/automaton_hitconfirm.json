      "url": "https://www.addtoany.com/add_to/bluesky?linkurl=https%3A%2F%2Fautomaton-media.com%2Farticles%2Fnewsjp%2Fphantom-blade-zero-20250922-358629%2F&linkname=%E6%AC%A1%E3%81%AA%E3%82%8BPS5%2FPC%E3%81%AE%E5%A4%A7%E5%9E%8B%E6%9C%9F%E5%BE%85%E4%BD%9C%E3%80%8EPhantom%20Blade%20Zero%E3%80%8F%E6%9C%80%E9%AB%98%E9%9B%A3%E6%98%93%E5%BA%A6%E3%83%9C%E3%82%B9%E3%81%AF%E3%80%8C%E6%A0%BC%E3%82%B2%E3%83%BC%E9%A2%A8AI%E3%80%8D%E6%90%AD%E8%BC%89%E3%80%82%E2%80%9C%E3%83%92%E3%83%83%E3%83%88%E7%A2%BA%E8%AA%8D%E2%80%9D%E3%81%BE%E3%81%A7%E3%81%99%E3%82%8B%E3%80%81%E3%83%91%E3%82%BF%E3%83%BC%E3%83%B3%E8%AA%AD%E3%81%BF%E5%9B%B0%E9%9B%A3%E3%81%AA%E5%87%B6%E6%82%AA%E3%83%9C%E3%82%B9%E3%81%AB"
